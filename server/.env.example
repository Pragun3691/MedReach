NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medreach
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JAAS_APP_ID=vpaas-magic-cookie-replace-with-your-app-id
JAAS_API_KEY_ID=vpaas-magic-cookie-replace-with-your-app-id/replace-with-your-key-id
JAAS_PRIVATE_KEY_BASE64=<base64-encoded-pem-rsa-private-key>
JAAS_TOKEN_TTL_SECONDS=600
